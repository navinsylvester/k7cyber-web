# Database connection string
DATABASE_URL=postgres://k7:k7@127.0.0.1:5434/k7

# Or use a PG connection string
#DATABASE_URL=postgresql://127.0.0.1:5432/your-database-name

# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret used to authenticate cron jobs (Payload jobs, and the support portal's SLA sweep: POST /api/support/sla/sweep)
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE

# ---- Support portal (Dataverse) — see docs/support-portal/08-implementation-plan.md §6 ----
DATAVERSE_URL=https://k7crmuat.crm8.dynamics.com # UAT (development). Production (k7crm) is READ-ONLY: the code refuses writes to that host
DATAVERSE_TENANT_ID=005ef94f-7dbd-4d0e-a29a-494e2a63d911
DATAVERSE_CLIENT_ID=
DATAVERSE_CLIENT_SECRET=
DATAVERSE_MOCK=
AUTH_SECRET=
AUTH_URL=                               # only behind a tunnel or proxy that rewrites Host: the public https origin (scripts/dev-tunnel.sh sets it); unset for localhost
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/005ef94f-7dbd-4d0e-a29a-494e2a63d911/v2.0
AUTH_CUSTOMER_ISSUER=
AUTH_CUSTOMER_ID=
AUTH_CUSTOMER_SECRET=
DATAVERSE_WRITES_ENABLED=1              # 1 = writes allowed against UAT; irrelevant for production (always refused)
SUPPORT_PORTAL_WRITES=
# Development conveniences (ignored in production builds)
SUPPORT_DEV_AGENT=probe                 # opens the "Continue as probe user" door (scripts/.token_cache.json); never on a host other people can reach
SUPPORT_DEV_SERVICE=                    # probe = the probe token stands in for the service app (customer side) without opening that door; implied by SUPPORT_DEV_AGENT=probe
SUPPORT_DEV_SHOW_CODE=1                 # show the customer's one-time code on the verify page when no SMTP_URL is set; off-localhost only with SUPPORT_MAIL_ALLOWLIST
SUPPORT_UAT_WRITE_TESTS=                # 1 lets tests/int/support-uat.int.spec.ts create and close a case in UAT with the probe token
YODIZ_URL_PATTERN=                      # product desk, phase A: makes typed tracker keys clickable, e.g. https://app.yodiz.com/.../{key}; the Yodiz adapter is phase B
# Mail for one-time codes and case notifications (console when unset)
SMTP_URL=
SUPPORT_MAIL_FROM="K7 Support <support@k7computing.com>"
SUPPORT_MAIL_ALLOWLIST=                 # shared test hosts: addresses/domains the portal may mail or issue codes to (priya@k7computing.com, @k7computing.com); unset = everyone
# ---- Partner portal — see docs/partner-portal/02-build-plan.md §8 ----
PARTNER_PORTAL_ENABLED=1                # on in development by default (0 turns it off); production needs 1. K7 staff roles live in the Payload global partner-settings
PARTNER_SMS_PROVIDER=                   # mobile one-time codes on /partners/join (FR-REG-03): empty = none (the mobile is recorded, its verification marked skipped); console = log the code (development)
# scripts/dataverse-probe.py (python): device-code sign-in as yourself, UAT by default
DV_ORG_URL=https://k7crmuat.crm8.dynamics.com     # probe: UAT by default; production only deliberately
DV_TENANT_ID=005ef94f-7dbd-4d0e-a29a-494e2a63d911
DV_AUTH=device
